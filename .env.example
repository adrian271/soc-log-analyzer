# Postgres. Matches docker-compose.yml (host port 5433 to avoid clashing with a
# local Postgres on 5432).
DATABASE_URL=postgresql://soc:soc_dev_password@localhost:5433/soc_logs

# Secret used to sign the session JWT. Any long random string works locally.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=dev-only-change-me-to-a-long-random-string

# Demo account created by `npm run db:migrate`.
DEMO_USER_EMAIL=analyst@tenex.local
DEMO_USER_PASSWORD=SocAnalyst!2024

# OPTIONAL. If set, uploaded-log findings are additionally sent to Claude to
# write the analyst-facing narrative summary. Everything else (parsing,
# detection, scoring) is deterministic and runs without this key.
# ANTHROPIC_API_KEY=sk-ant-...
